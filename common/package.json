{
  "name": "@tamaldip/uvsu-common",
  "version": "1.0.21",
  "description": "Shared types and zod schemas",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc",
    "release": "standard-version",
    "publish-package": "npm publish --access public",
    "install-frontend": "cd ../frontend && npm install @tamaldip/uvsu-common@latest",
    "install-backend": "cd ../backend && npm install @tamaldip/uvsu-common@latest --legacy-peer-deps",
    "sync": "concurrently \"npm:install-frontend\" \"npm:install-backend\"",
    "update": "npm run release && npm run build && npm run publish-package && sleep 2 && npm run sync"
  },
  "dependencies": {
    "zod": "^4"
  },
  "devDependencies": {
    "concurrently": "^9",
    "rimraf": "^6",
    "standard-version": "^9",
    "tsup": "^8",
    "typescript": "^7.0.2"
  }
}
